<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aura_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/backButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="-12dp"
            android:minWidth="0dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="@color/aura_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Settings"
            android:textColor="@color/aura_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Mode selector: Aura Credits, or BYOK (advanced). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="AI Mode"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/modeCreditsRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/aura_primary"
                    android:text="Aura Credits"
                    android:textColor="@color/aura_on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="4dp"
                    android:text="Sign in with Google and buy credit packs — no API key of your own needed."
                    android:textColor="@color/aura_on_surface_variant"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/modeByokRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/aura_primary"
                    android:text="Bring your own API key (Advanced)"
                    android:textColor="@color/aura_on_surface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Use your own key with an AI provider you choose."
                    android:textColor="@color/aura_on_surface_variant"
                    android:textSize="13sp" />

            </RadioGroup>

        </LinearLayout>

        <!-- BYOK provider fields (hidden in Aura Credits mode). -->
        <LinearLayout
            android:id="@+id/byokSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="AI Provider"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/providerSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/settings_input_bg"
                android:padding="12dp"
                android:popupBackground="@color/aura_card" />

            <TextView
                android:id="@+id/apiKeyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API Key"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/settings_input_bg"
                android:hint="Paste API Key Here"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/aura_on_surface"
                android:textColorHint="@color/aura_on_surface_variant" />

            <TextView
                android:id="@+id/baseUrlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Base URL"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/settings_input_bg"
                android:hint="http://192.168.1.x:11434"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/aura_on_surface"
                android:textColorHint="@color/aura_on_surface_variant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/modelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="AI Model"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/settings_input_bg"
                android:padding="12dp"
                android:popupBackground="@color/aura_card" />

            <EditText
                android:id="@+id/customModelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/settings_input_bg"
                android:hint="Enter model name (e.g. openai/gpt-oss-20b)"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/aura_on_surface"
                android:textColorHint="@color/aura_on_surface_variant"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Aura Credits account panel (hidden in BYOK mode). -->
        <LinearLayout
            android:id="@+id/creditsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/settings_card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Aura Credits Account"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/creditsAccountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Not signed in"
                android:textColor="@color/aura_on_surface_variant" />

            <TextView
                android:id="@+id/creditsBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/aura_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Each verse lookup costs 1 credit."
                android:textColor="@color/aura_on_surface_variant" />

            <Button
                android:id="@+id/creditsSignInButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/settings_pill_primary"
                android:text="Sign in with Google"
                android:textAllCaps="false"
                android:textColor="@color/aura_on_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/creditsSignOutButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/settings_pill_surface"
                android:text="Sign out"
                android:textAllCaps="false"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buyCreditsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Buy credits"
                android:textColor="@color/aura_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/creditsProductsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/creditsProductsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textColor="@color/aura_on_surface_variant"
                android:visibility="gone" />

            <Button
                android:id="@+id/creditsDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_pill_danger"
                android:text="Delete account and data"
                android:textAllCaps="false"
                android:textColor="@color/aura_on_error_container"
                android:textSize="16sp"
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/settings_pill_primary"
            android:text="Save &amp; Start Service"
            android:textAllCaps="false"
            android:textColor="@color/aura_on_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/providerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:autoLink="web"
            android:textColor="@color/aura_on_surface_variant" />

    </LinearLayout>
</ScrollView>
