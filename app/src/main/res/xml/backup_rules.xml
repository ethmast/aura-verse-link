<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (API < 31 path via fullBackupContent; ignored on API 31+,
   where data_extraction_rules.xml applies instead).

   SharedPreferences hold the user's AI provider API keys. They are excluded
   from backup so a key can never be lifted from a cloud backup — the user
   simply re-enters it on a new device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
