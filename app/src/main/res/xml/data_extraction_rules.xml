<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+). Same policy as backup_rules.xml:
   SharedPreferences — which hold AI provider API keys — are excluded from
   both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
