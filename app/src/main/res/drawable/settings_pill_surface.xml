<?xml version="1.0" encoding="utf-8"?>
<!-- Full-pill secondary button used inside Settings cards (sign-out,
     credit pack buttons), where the card-colored pill would disappear
     into the card itself. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@color/aura_input" />
</shape>
